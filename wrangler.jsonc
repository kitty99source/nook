{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nook",
  "main": "worker.mjs",
  "account_id": "fc398eb41639385a99da595813439dfa",
  "compatibility_date": "2026-10-14",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash"
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOM", "class_name": "NookRoom" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["NookRoom"] }
  ],
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "routes": [
    { "pattern": "nooknook.world", "custom_domain": true },
    { "pattern": "www.nooknook.world", "custom_domain": true }
  ]
}
